# Copy this file to a local, untracked .env or configure the values in your
# worker's secret store. Never commit real credentials or signed URLs.

NOTIFICATION_SOURCE_APPLICATION=task-runner

# Classic Outlook account selection (Windows worker only).
OUTLOOK_ACCOUNT_ADDRESS=worker@contoso.com
OUTLOOK_SEND_AS_ADDRESS=

# Store each complete provider-generated signed URL as one secret. Do not split
# the URL into a host suffix, token, or custom header.
PA_TEAMS_OPS_ALERTS_SIGNED_URL=https://replace-with-complete-signed-url.invalid/trigger?sig=replace-me

# Optional opt-in smoke test; leave blank for normal offline test runs.
NOTIFICATION_TEST_PA_SIGNED_URL=
